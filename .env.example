# Copy to .env.local and fill in. Never commit real values.

# --- Used now ---------------------------------------------------------------
# Public base URL, used for metadata (e.g. http://localhost:3000 locally,
# https://your-app.vercel.app in production). Optional.
NEXT_PUBLIC_SITE_URL=
# Optional: shows a "Source code" link in the footer.
NEXT_PUBLIC_REPOSITORY_URL=

# --- Phase 4: Supabase (not used yet) ------------------------------------------
# Project URL and publishable key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only add a service-role key if a server-only feature genuinely requires it.
# It must never be exposed to the browser (no NEXT_PUBLIC_ prefix).
# SUPABASE_SERVICE_ROLE_KEY=

# --- Testing (optional) ------------------------------------------------------
# Run Playwright against an installed browser instead of the bundled Chromium,
# e.g. "chrome" on macOS 12 where bundled browsers are unsupported.
# E2E_BROWSER_CHANNEL=chrome
